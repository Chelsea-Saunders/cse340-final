<%- include('../partials/header') %>


<section
    class="item-detail"
    data-product-detail
    data-product-id="<%= product.id %>"
    data-product-name="<%= product.name %>"
    data-product-price="<%= product.price %>"
    data-product-image="<%= product.image_med || product.image_sm %>"
>
    <img src="<%= product.image_lg || product.image_med %>" 
            alt="<%= product.name %>"
    >

    <div class="product-detail-info">
        <h1><%= product.name %></h1>
        <p class="description"><%= product.description %></p>
        <div class="bottom">
            <p class="price">$<%= product.price %></p>
            <% if (product.available_quantity === 0) { %> 
                <p class="stock-status out-of-stock">
                    Out of Stock
                </p>
            <% } else if (product.available_quantity <= 1) { %>
                <p class="stock-status low-stock">
                    Only <%= product.available_quantity %> left!
                </p>
            <% } else { %>
                <p class="stock-status in-stock">
                    In Stock: <%= product.available_quantity %> available
                </p>
            <% } %>

            <label for="quantity">Quantity:</label>
            <input 
                id="quantity"
                class="quantity" 
                type="number" 
                value="1" 
                min="1" 
                max="<%= Math.min(product.available_quantity, 10) %>"
                step="1"
                data-quantity
                <%= product.available_quantity === 0 ? 'disabled' : '' %>
            >

            <button 
                type="button" 
                data-add-to-cart
                <%= product.available_quantity === 0 ? 'disabled' : '' %>
                >
                <%= product.available_quantity === 0 ? 'Out of Stock' : 'Add to Cart' %>
            </button>
            <p class="cart-message" data-cart-message></p>
        </div>
        
    </div>
</section>

<%- include('../partials/footer') %>