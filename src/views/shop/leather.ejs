<%- include('../partials/header') %>
    <main>
        <h1>Leather Gallery</h1>
        <div class="leather" id="leather">
            <% products.forEach((product) => { %>
                <figure class="leather-card">
                    <img 
                        src="<%= product.image_sm %>"
                        srcset="
                            <%= product.image_sm %> 250w,
                            <%= product.image_med %> 400w,
                            <%= product.image_lg %> 500w
                        "
                        sizes="(max-width: 700px) 90vw, 400px"
                        alt="<%= product.alt %>"
                        loading="lazy"
                        decoding="async"
                    >
                    <figcaption class="product-info">
                        <h3><%= product.name %></h3>
                        <p class="price"><%= product.price %></p>
                        <!-- <p class="description"><%= product.description %></p> -->
                    </figcaption>
                </figure>
            <% }) %>
        </div>
        <p class="description">I offer a wide range of handcrafted items, from hat holders 
            to welding helmets, and everything in between. Whether you're
            looking for a unique accessory, durable protective gear, or 
            a one-of-a-kind piece, I’m always open to experimenting with
            new ideas and techniques. Each project is made with 
            precision, care, and attention to detail, ensuring a 
            high-quality, personalized result. Let’s bring your vision 
            to life with custom leather craftsmanship just for you!
        </p>
<%- include('../partials/footer') %>