<%- include('../partials/header') %>

<h1>Screen Prints Gallery</h1>
<div class="screen-prints" id="screen-prints">
    <% products.forEach((product) => { %>
        <figure class="screen-prints-card">
            <img 
                src="<%= product.image_sm %>"
                srcset="
                    <%= product.image_sm %> 250w,
                    <%= product.image_med %> 400w,
                    <%= product.image_lg %> 500w
                "
                sizes="(max-width: 700px) 90vw, 400px"
                alt="<%= product.alt %>"
                loading="lazy"
                decoding="async"
            >
            <figcaption class="product-info">
                <h3><%= product.name %></h3>
                <p class="price">$<%= product.price %></p>
                <!-- <p class="description"><%= product.description %></p> -->
            </figcaption>
        </figure>
    <% }) %>
</div>

<%- include('../partials/footer') %>