<%- include('../partials/header') %>

<main class="account-dashboard-page contact-messages-page">
    <h1><%= title %></h1>

    <p>View and manage customer inquiries.</p>

    <% if (messages.length === 0) { %>
        <p>No contact messages found.</p>
    <% } else { %>
        <div class="contact-table-wrapper">
             <table class="management-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Response</th>
                    </tr>
                </thead>

                <tbody>
                    <% messages.forEach(message => { %>
                    <tr>
                        <td>
                            <%= new Date(message.created_at).toLocaleDateString() %>
                        </td>
                        <td><%= message.name %></td>
                        <td><%= message.email %></td>
                        <td><%= message.subject %></td>
                        <td><%= message.message %></td>
                        <td><%= message.status %></td>
                        <td>
                            <% if (message.status === 'pending') { %>
                                <form
                                    action="/dashboard/contact-messages/<%= message.id %>/respond"
                                    method="POST"
                                    class="contact-response-form"
                                >
                                    <textarea 
                                        name="response"
                                        placeholder="Enter your response"
                                        maxlength="5000"
                                        required
                                    ></textarea>

                                    <button type="submit">Respond</button>
                                    
                                </form>
                            <% } else { %>
                            <p><%= message.response %></p>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>

    <a href="/dashboard/employee" class="continue-shopping">
        Back to Employee Dashboard
    </a>
</main>

<%- include('../partials/footer') %>