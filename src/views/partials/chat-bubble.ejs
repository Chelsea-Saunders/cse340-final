
<div class="chat-container">
            <div class="chat-bubble" id="chatToggle">💬</div>
            <div class="chat-box" id="chatBox">
                <div class="chat-header">
                    <span>Need help?</span>
                    <button id="closeChat">x</button>
                </div>
                <div class="chat-body">
                    <form id="chat-form">
                        <label for="chat-message">
                            Hi! Do you have a question or want to special order a product? Let's talk about it!
                        </label>
                        <textarea id="chat-message" name="message" rows="4" required></textarea><br>
                        <button type="submit">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </main>
