<%- include('../partials/header') %>

<main class="account-dashboard-page">
    <h1><%= title %></h1>

    <% if (updated) { %>
        <p class="profile-success" role="status">
            Your profile has been updated successfully!
        </p>
    <% } %>

    <form action="/dashboard/profile" method="POST" class="profile-form">
        <label for="name">Full Name</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= user.name %>"
            maxlength="100"
            required
        >

        <label for="email">Email Address</label>
        <input
            type="email"
            id="email"
            value="<%= user.email %>"
            readonly
        >

        <button type="submit">Save Changes</button>

    </form>
    <a href="/dashboard" class="continue-shopping">
        Back to My Account
    </a>
</main>

<%- include('../partials/footer') %>