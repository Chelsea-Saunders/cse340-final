<%- include('../partials/header') %>
<% const isEdit = !!produce; %>

<main class="dashboard-edit">
    <h1><%= title %></h1>

    <form action="<%= isEdit ? `/dashboard/edit/${product.id}': '/dashboard/add' %>" method="POST">
        <label for="name">
            Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= product ? product.name : '' %>" 
                    required
                >
        
        <label for="category">
            Category</label>
                <input 
                type="category"
                id="category"
                name="category"
                 value="<%= product ? product.category : '' %>" 
                required
                >
        </label>
            
        <label for="description">
            Description</label>
                <textarea 
                    id="description" 
                    name="description">
                    <%= product ? product.description : '' %>
                </textarea>
        </label>
        
        <label for="price">
            Price</label>
        <input 
            type="number" 
            step="0.01"
            id="price" 
            name="price" 
            value="<%= product ? product.price : '' %>" 
            required
            >

        <label for="image_url">
            Image URL</label>
        <input 
            type="text" 
            id="image_url"
            name="image_url" 
            value="<%= product ? product.image_url : '' %>"
        >

        <button type="submit">
            <%= product ? 'Update Product' : 'Add Product' %>
        </button>
    </form>
</main>

<%- include('../partials/footer') %>