<%- include('../partials/header') %>
<% const isEdit = !!product; %>

<main class="dashboard-edit">
    <h1><%= title %></h1>

    <form 
        action="<%= isEdit ? `/dashboard/edit/${product.id}` : '/dashboard/add' %>" 
        method="POST"
        enctype="multipart/form-data"
    >
        <label for="name">
            Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= product ? product.name : '' %>" 
                    required
                >
        
        <label for="category">
            Category</label>
                <input 
                type="text"
                id="category"
                name="category"
                 value="<%= product ? product.category : ''%>" 
                required
                >
        </label>
            
        <label for="description">
            Description</label>
                <textarea 
                    id="description" 
                    name="description">
                    <%= product ? product.description : ''%>
                </textarea>
        </label>
        
        <label for="price">
            Price</label>
        <input 
            type="number" 
            step="0.01"
            id="price" 
            name="price" 
            value="<%= product ? product.price : '' %>" 
            required
            >

        <label for="product_image">Product Image</label>
        <input 
            type="file" 
            id="product_image"
            name="product_image" 
            accept="image/jpeg, image/png, image/webp"
        >
        <% if (isEdit && product.image_sm) { %>
        <p>Current image:</p>
        <img 
            src="<%= product.image_sm %>"
            alt="<%= product.name %>"
            class="product-image-preview"
        >
        <p>Leave fele filed empty to keep the current image</p>
        <% } %>

        <label for="stock_quantity">Quantity Available</label>
        <input 
            type="number"
            id="stock_quantity"
            name="stock_quantity"
            min="0"
            step="1"
            required
            value="<%= product ? product.stock_quantity : 0 %>"
        >

        <button type="submit">
            <%= product ? 'Update Product' : 'Add Product' %>
        </button>
    </form>
</main>

<%- include('../partials/footer') %>