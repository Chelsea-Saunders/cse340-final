<%- include('../partials/header') %>

<main class="dashboard-edit">
    <h1><%= title %></h1>

    <form action="<%= product ? '/dashboard/edit/' + product.id : '/dashboard/add' %>" method="POST">
        <label for="name">
            Name
            <input 
                type="text"
                id="name"
                name="name"
                value="<%= product ? product.name : '' %>"
                required
            >
        </label>

        <label for="category">
            Category
            <select id="category" name="category" required>
                <% ['leather', 'photography', 'screen-prints'].forEach(cat => { %>
                    <option value="<%= cat %>" <%= product && product.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </label>

        <label for="description">
            Description
                <textarea id="description" name="description"><%= product ? product.description : '' %></textarea>
        </label>

        <label for="price">
            Price
            <input
                type="number"
                step="0.01"
                id="price"
                name="price"
                value="<%= product ? product.price : '' %>"
            >
        </label>

        <label for="image_url">
            Image URL
            <input
                type="text"
                id="image_url"
                name="image_url"
                value="<%= product ? product.image_url : '' %>"
            >
        </label>

        <button 
            type="submit">
            <%= product ? 'Save Changes' : 'Add Product' %>
        </button>
    </form>
</main>

<%- include('../partials/footer') %>