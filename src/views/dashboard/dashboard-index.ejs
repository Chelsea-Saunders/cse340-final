<%- include('../partials/header') %>

<main class="account-dashboard-page">
    <h1><%= title %></h1>

    <p class="welcome-p">Welcome back, <%= user.name %>!</p>

    <div class="account-dashboard">

        <a href="/checkout/orders" class="account-card">
            <h2>My orders</h2>
            <p>View your order history and purchases.</p>
        </a>

        <a href="/dashboard/profile" class="account-card">
            <h2>My Profile</h2>
            <p>View and update your account information.</p>
        </a>

        <a href="/dashboard/security" class="account-card">
            <h2>My Security</h2>
            <p>Manage your password and sign-in information.</p>
        </a>

    </div>
</main>

<%- include('../partials/footer') %>