<%- include('../partials/header') %></>

<main class="account-dashboard-page admin-products-page">
    <h1><%= title %></h1>

    <p class="welcome-p">
        Add, edit, or remove products from your store.
    </p>

    <div class="admin-product-actions">
        <a href="/dashboard/add" class="button">
            + Add New Product
        </a>
    </div>

    <% if (products.length === 0) { %>
        <p>No products found. Add your first product!</p>
    <% } else { %> 
        <section class="admin-product-list">
            <% products.forEach(product => { %>
                <article class="account-card admin-product-card">

                    <div class="admin-product-main">

                        <div class="admin-product-image">
                            <% if (product.image_sm) { %> 
                                <img 
                                    src="<%= product.image_sm %>"
                                    alt="<%= product.name %>"
                                    loading=lazy
                                >
                            <% } %>
                        </div>

                        <div class="admin-product-info">
                            <h2><%= product.name %></h2>
                            <p>Category: <%= product.category %></p>
                            <p>
                                Price: $<%= Number(product.price).toFixed(2) %>
                            </p>

                            <% if (product.stock_quantity === 0) { %> 
                                <p class="stock-status out-of-stock">Out of Stock</p>
                            <% } else if (product.stock_quantity <= 1) {%> 
                                <p class="stock-status low-stock">
                                    Low Stock: <%= product.stock_quantity %> left
                                </p>
                            <% } else { %>
                                <p class="stock-status in-stock">
                                    In Stock: <%= product.stock_quantity %>
                                </p>
                            <% } %>
                        </div>

                        <div class="admin-product-controls">
                            <a href="/dashboard/edit/<%= product.id %>"
                                class="button">
                                Edit
                            </a>

                            <form 
                                action="/dashboard/delete/<%= product.id %>"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this product?');"
                            >
                                <button type="submit" class="button">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            <% }) %>
        </section>
    <% } %>

    <a href="/dashboard/admin" class="continue-shopping">
        Back to Admin Dashboard
    </a>
</main>

<%- include('../partials/footer') %>